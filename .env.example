# Copy to .env.local for local development. Never commit real values.
REPOSITORY=memory              # memory | dynamo
# TABLE_NAME=burger-local
# AWS_REGION=ca-central-1
# DYNAMODB_ENDPOINT=http://localhost:8000   # DynamoDB Local only
CHAT_MODE=mock                 # mock (local tool console, never in production) | connect
# CHAT_MODE=connect: values from the Connect widget page (docs/connect-setup.md). Never commit the key.
CONNECT_WIDGET_SCRIPT_URL=
CONNECT_WIDGET_ID=
CONNECT_WIDGET_SNIPPET_ID=
CONNECT_WIDGET_SECURITY_KEY=
CONNECT_ASSISTANT_ID=          # Q Connect assistant id (not secret); turns on the call transcript panel
PUBLIC_BASE_URL=http://localhost:3000
ADMIN_USERNAME=owner
ADMIN_PASSWORD_HASH=           # npm run hash-password
SESSION_SECRET=                # at least 32 random characters, e.g. openssl rand -base64 48
