{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OrdersTable",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:Query", "dynamodb:ConditionCheckItem"],
      "Resource": ["arn:aws:dynamodb:ca-central-1:<ACCOUNT_ID>:table/burger-orders", "arn:aws:dynamodb:ca-central-1:<ACCOUNT_ID>:table/burger-orders/index/*"]
    },
    {
      "Sid": "CallTranscript",
      "Effect": "Allow",
      "Action": ["wisdom:SearchSessions", "wisdom:ListSpans"],
      "Resource": ["arn:aws:wisdom:ca-central-1:<ACCOUNT_ID>:assistant/<ASSISTANT_ID>", "arn:aws:wisdom:ca-central-1:<ACCOUNT_ID>:session/<ASSISTANT_ID>/*"]
    }
  ]
}
